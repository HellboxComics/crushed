# copy to .env, fill in, then: source .env
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
OWNER=0xYourAddress
# sha256 of collection/manifest.json (see collection/provenance.txt)
PROVENANCE=0x
# keccak256(abi.encodePacked(secret)); keep the secret offline until reveal:
#   cast keccak $(cast to-bytes32 <secret>)   or   cast keccak 0x<32-byte secret>
REVEAL_COMMIT=0x
PRICE_WEI=0
MAX_PER_WALLET=8
SEALED_URI=ipfs://<cid>/sealed.json
CONTRACT_URI=ipfs://<cid>/contract.json
ROYALTY_RECEIVER=0xYourAddress
ROYALTY_BPS=500
